CompileFlags:
  Add: [-Wno-unknown-attributes, -Wno-maybe-uninitialized, -Wno-unknown-warning-option]
  Remove: [-W*, -mmcu=*, -mcpu=*, -mfpu=*, -mfloat-abi=*, -mno-unaligned-access, -mno-thumb-interwork, -mcall-prologues, -mlra, -D__has_include*, -D__STDC_VERSION__=*]
  Compiler: clang
Diagnostics:
  Includes:
    IgnoreHeader: [default_keyboard\.h]
