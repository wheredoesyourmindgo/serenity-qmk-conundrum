{
    "editor.insertSpaces": true,
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.inc": "c"
    },
    "files.exclude": {
        "**/.build": true,
        "**/*.hex": true,
        "**/*.bin": true,
        "**/*.uf2": true
    },
    "[markdown]": {
        "editor.trimAutoWhitespace": false,
        "files.trimTrailingWhitespace": false
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--header-insertion=never"
    ],
    "makefile.configureOnOpen": false
}
